# MarketInsight API Environment Variables

PORT=8000
CORS_ORIGIN=*

# eBay Official Developer API (OAuth Client Credentials)
# Get credentials free at: https://developer.ebay.com/
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here
EBAY_ENV=PRODUCTION

# Amazon Product Advertising API (PA-API v5)
# Get credentials at: https://affiliate-program.amazon.com/
AMAZON_PAAPI_ACCESS_KEY=your_amazon_access_key_here
AMAZON_PAAPI_SECRET_KEY=your_amazon_secret_key_here
AMAZON_PAAPI_TAG=your_partner_tag_here
